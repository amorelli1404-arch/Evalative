# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored -- never commit real secret keys.

# Clerk (authentication) -- get these from https://dashboard.clerk.com
# after creating a Clerk application. The publishable key is safe to
# expose to the browser; the secret key must stay server-side only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Backend API this app talks to for checkout/evaluations.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public URL of this site, used to build Stripe/checkout redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
